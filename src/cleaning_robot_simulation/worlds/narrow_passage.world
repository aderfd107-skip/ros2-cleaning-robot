      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 3.2 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 3.2 0.9</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="right_block">
      <static>true</static>
